# Michibiki configuration
# Copy to .env and fill in values

# AniList API token (get from https://anilist.co/settings/developer)
# Create a client, then visit:
# https://anilist.co/api/v2/oauth/authorize?client_id=YOUR_CLIENT_ID&response_type=token
ANILIST_TOKEN=your_token_here

# Suwayomi GraphQL endpoint (Docker internal DNS)
SUWAYOMI_URL=http://suwayomi:4567/api/graphql

# Sync interval in seconds (86400 = 24 hours)
POLL_INTERVAL_SECONDS=86400

# Dry run mode — set to false to actually push to AniList
DRY_RUN=true

# Operating mode: "watch" for backup watcher, "poll" for Suwayomi→AniList
MODE=watch

# ---- Host paths (container-internal BACKUP_DIR above; these are the HOST side) ----
# Michibiki's state directory (SQLite + covers)
MICHIBIKI_DATA_DIR=./data
# Directory the Mihon auto-backups land in (Syncthing target folder)
BACKUP_HOST_DIR=./backups
# Suwayomi's data + config directories
SUWAYOMI_DATA_DIR=./suwayomi/data
SUWAYOMI_CONFIG_DIR=./suwayomi/config

# Suwayomi downloads directory — where CBZ files land. Any host path works:
#   ./suwayomi/data/downloads (default — inside Suwayomi's data dir)
#   /mnt/nas/manga  (CIFS/NFS mount point)
#   /srv/manga      (local folder)
SUWAYOMI_DOWNLOADS_DIR=./suwayomi/data/downloads

# Suwayomi population
POPULATE_SUWAYOMI=true
CLEAR_SUWAYOMI_FIRST=false
